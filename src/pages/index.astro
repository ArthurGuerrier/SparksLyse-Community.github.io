---
import Layout from "../layouts/Layout.astro";
import FeatureTab from "../components/FeatureTab";
import HowItWorksTab from "../components/HowItWorksTab";
import BenefitsCards from "../components/BenefitsCards";
import CarouselTestimonials from "../components/CarouselTestimonials";
import FAQs from "../components/FAQs";

// Images
import headerImage from "../assets/images/header.png"
import aboutImage1 from "../assets/images/about1.jpg"
import aboutImage2 from "../assets/images/about2.jpg"
import aboutImage3 from "../assets/images/about3.jpg"
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

const about: { title: string; description: string; image: ImageMetadata }[] = [
  {
    title: "Le temps s'est déroulé",
    description:
      "Automatisez vos tâches et gagnez du temps : votre assistant IA transforme les tâches routinières en quelques secondes pour que vous puissiez vous concentrer sur votre croissance.",
    image: aboutImage1,
  },
  {
    title: "Des mots qui coulent",
    description:
      "Brouillons, articles de blog et courriels rédigés avec clarté et rapidité — l'élégance du langage sans la difficulté.",
    image: aboutImage2,
  },
  {
    title: "Un guide silencieux",
    description:
      "Toujours présents pour vous aider à rester concentré – suggestions, rappels et idées au moment précis où vous en avez besoin.",
    image: aboutImage3,
  },
];

const benefits: { title: string; description: string; logo: number }[] = [
  {
    title: "le temps est inversé",
    description:
      "Automatisez les tâches routinières et libérez du temps facilement.",
    logo: 0,
  },
  {
    title: "Des mots en toute simplicité",
    description:
      "Transformez vos idées en écrits soignés — clairs, naturels et rapides.",
    logo: 1,
  },
  {
    title: "Mise au point guidée",
    description:
      "Restez concentré grâce à des incitations douces qui éloignent les distractions.",
    logo: 2,
  },
  {
    title: "Connaissance instantanée",
    description:
      "Condensez vos recherches et vos analyses en informations claires.",
    logo: 3,
  },
  {
    title: " Toujours disponible",
    description:
      "Votre partenaire discret, prêt à vous aider dès que vous en avez besoin.",
    logo: 4,
  },
  {
    title: "Confiance intégrée",
    description:
      "Protection dès la conception — vos données, vos idées, toujours en sécurité.",
    logo: 5,
  },
];

---

<Layout
  title="Lyse.AI, l'IA Open-Source"
  description="Quand l'IA rencontre l'Open-Source"
  ogImage="images/ogImage.jpg"
>
  <main>
    <header
      id="hero"
      class="relative flex min-h-screen w-full flex-col items-center justify-center gap-20 overflow-hidden px-4 pb-16 md:pb-24"
    >
      <div
        class="relative z-10 flex w-full max-w-125 flex-col items-center gap-8 text-center"
      >
        <div class="flex w-full flex-col items-center gap-4">
          <h1
            class="font-sans text-[40px] font-normal leading-[1.2] tracking-[-0.03em] text-white sm:text-[48px] lg:text-[56px]"
          >
            Quand l'IA rencontre l'Open-Source
          </h1>

          <p
            class="text-center text-sm leading-[1.3] text-white/90 sm:text-base"
          >
            Une IA open-source pour vous aider à y voir plus clair
          </p>
        </div>

        <a
          href="#about"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/15 bg-white px-7 text-sm text-[#551A8B] transition duration-300"
        >
          Commencer
        </a>
      </div>

      <a
        href="#about"
        class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-xs tracking-wide text-white/55 transition hover:text-white"
      >
        Descendez pour voir
      </a>

      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(232,255,156,0.07),transparent_38%)]"
      >
      </div>
      <div>
        <div
          class="z-1 flex-none w-full h-full absolute top-0 left-0 overflow-hidden"
          style="will-change: transform; opacity: 1; transform: scale(1.05)"
        >
          <div
            style="
				position: absolute;
				border-radius: inherit;
				corner-shape: inherit;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				"
          >
            <Image
              decoding="async"
              width="2912"
              height="1632"
              src={headerImage}
              aria-hidden="true"
              alt="Header"
              style="
					width: 100%;
					height: 100%;
					border-radius: inherit;
					corner-shape: inherit;
					object-position: center;
					object-fit: cover;
				"
            />
          </div>
        </div>
      </div>
    </header>

    <section
      id="about"
      class="mx-auto flex w-full max-w-300 flex-col gap-16 px-6 py-24 md:px-10 md:py-32 lg:px-16"
    >
      <div class="grid gap-8 lg:grid-cols-[1.05fr_1fr] lg:items-end">
        <div>
          <span
            class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
            >À propos</span
          >
          <h2
            class="max-w-2xl font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
          >
            Exploitez une puissance pour écrire plus vite, mieux vous concentrer
            et gagner des heures.
          </h2>
        </div>
      </div>

      <div
        class="grid overflow-hidden rounded-3xl"
        style={`grid-template-columns: repeat(${about.length}, minmax(0, 1fr));`}
      >
        {
          about.map((ab) => (
            <article class="p-2 md:p-1">
              <Image
                src={ab.image}
                width="352"
                height="320"
                alt={`${ab.title}`}
                class="rounded-sm"
                loading="lazy"
              />
              <p class="mb-4 mt-2 text-lg text-white">{ab.title}</p>
              <p class="text-sm leading-7 text-white/55">{ab.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      id="features"
      class="mx-auto w-full max-w-300 px-6 py-24 md:px-10 md:py-32 lg:px-16"
    >
      <div class="mb-14 max-w-2xl">
        <span
          class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
          >Différents cas</span
        >
        <h2
          class="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
        >
          Différents chemins à explorer, <span
            style="color: rgb(133, 133, 133);"
            >tous guidés par un compagnon silencieux.</span
          >
        </h2>
      </div>

      <FeatureTab client:load />
    </section>

    <section id="how-it-works" class="border-y">
      <div
        class="mx-auto grid w-full max-w-300 gap-16 px-6 py-24 md:px-10 md:py-32 lg:px-16"
      >
        <div>
          <span
            class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
            >Comment ça fonctionne ?</span
          >
          <h2
            class="max-w-lg font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
          >
            Un prompt, <span style="color: rgb(133, 133, 133);"
              >trois étapes.</span
            >
          </h2>
        </div>

        <HowItWorksTab client:load />
      </div>
    </section>

    <section
      id="benefits"
      class="mx-auto w-full max-w-300 px-6 py-24 md:px-10 md:py-32 lg:px-16"
    >
      <div class="mb-14 max-w-3xl">
        <span
          class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
          >Les avantages</span
        >
        <h2
          class="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
        >
          Une puissance invisible à vos côtés, qui vous apporte des avantages
          concrets au quotidien.
        </h2>
      </div>

      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <BenefitsCards benefits={benefits} />
      </div>
    </section>

    <section id="testimonials" class="border-y border-white/10 bg-white/1.5">
      <div
        class="mx-auto w-full max-w-300 px-6 py-24 md:px-10 md:py-32 lg:px-16"
      >
        <div class="mb-12 max-w-2xl">
          <span
            class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
            >Testimonials</span
          >
          <h2
            class="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
          >
            Ce que d'autres murmurent à propos de l'expérience
          </h2>
        </div>

        <CarouselTestimonials client:visible />
      </div>
    </section>

    <section
      id="faq"
      class="mx-auto w-full max-w-250 px-6 py-24 md:px-10 md:py-32"
    >
      <div class="mb-12 text-center">
        <span
          class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
          >FAQ</span
        >
        <h2
          class="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
        >
          Vos questions, nos réponses
        </h2>
      </div>

      <FAQs client:load />
    </section>

    <section id="final-cta" class="px-6 pb-24 md:px-10 md:pb-32 lg:px-16">
      <div
        class="mx-auto flex w-full max-w-300 flex-col border border-white/10 bg-white/2.5 px-6 py-20 md:px-10 md:py-28"
        style=`
          border-radius: inherit;
          corner-shape: inherit;
          background-image: url(${headerImage.src});
          background-repeat: no-repeat;
          background-position: center center;
          background-size: cover;
          border: 0;`
      >
        <h2
          class="font-sans text-4xl font-normal leading-none tracking-[-0.03em] text-white sm:text-5xl"
        >
          Essayez maintenant
        </h2>
        <p class="mt-5 max-w-xl text-sm leading-7 text-white/55 sm:text-base">
          Cette IA est totallement gratuite, pourquoi pas la tester ?
        </p>
        <a
          href="/404"
          class="mt-8 w-26 inline-flex min-h-12 items-center justify-center rounded-full bg-[#e8ff9c] px-7 text-sm font-medium text-black transition hover:opacity-90"
        >
          Commencer
        </a>
      </div>
    </section>
  </main>
</Layout>
